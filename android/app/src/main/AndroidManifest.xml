<?xml version="1.0" encoding="utf-8"?>
<!-- Road Rash VR: a NativeActivity whose native library (librrgame.so, built by
     scripts/build-quest.ps1 from this tree with the NDK) is the game itself - the front end, the career, the races,
     the saves - on an OpenXR session over OpenGL ES 3.2. The activity protects saves during play; the save provider supports USB transfer. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="true"/>
    <uses-feature android:glEsVersion="0x00030002" android:required="true"/>
    <!-- hands supported, not required: without it the system blocks the launch behind a "controllers required"
         dialog whenever the Touch controllers are asleep (measured: RequiresControllersLaunchInterceptor) -->
    <uses-feature android:name="oculus.software.handtracking" android:required="false"/>
    <uses-permission android:name="com.oculus.permission.HAND_TRACKING"/>
    <!-- the Khronos loader's own manifest entries (openxr_loader_for_android): the permissions and the package
         visibility it needs to reach the runtime broker -->
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR"/>
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM"/>
    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker"/>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService"/>
        </intent>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRApiLayerService"/>
        </intent>
    </queries>
    <application android:allowBackup="false" android:label="Road Rash VR" android:hasCode="true">
        <meta-data android:name="com.oculus.supportedDevices" android:value="quest2|questpro|quest3|quest3s"/>
        <activity android:name=".RoadRashActivity" android:exported="true" android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenSize|screenLayout|uiMode|density"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <meta-data android:name="android.app.lib_name" android:value="rrgame"/>
            <meta-data android:name="com.oculus.vr.focusaware" android:value="true"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD"/>
                <category android:name="com.oculus.intent.category.VR"/>
            </intent-filter>
        </activity>
        <provider android:name=".SaveProvider" android:authorities="com.rrjb.vr.saves"
            android:process=":save_transfer" android:exported="true" android:permission="android.permission.DUMP"/>
    </application>
</manifest>
